---
import { profile } from '../../data/profile';
const { bio } = profile;
---

<section class="scr" data-screen="ABOUT" hidden>
  <div class="scr__bar"><span>About me</span></div>
  <div class="scr__body" data-scroll>
    <div class="lines">{bio.map((line) => <p>{line}</p>)}</div>

  </div>
  <div class="scr__hint"><span>B to go back</span></div>
</section>
