---
import { profile } from '../../data/profile';
---

<section class="scr" data-screen="STATS" hidden>
  <div class="scr__bar"><span>My stats</span></div>
  <div class="scr__body" data-scroll>
    <div class="row"><span class="row__k">Name</span><span>{profile.name}</span></div>
    <div class="row"><span class="row__k">Studying</span><span>{profile.course}</span></div>
    <h2 class="head">Currently</h2>
    <p>{profile.currently}</p>
    <h2 class="head">GitHub</h2>
    <a class="tag" href={profile.github} rel="noopener noreferrer">See GitHub →</a>
  </div>
  <div class="scr__hint"><span>Scroll to read · B to go back</span></div>
</section>
