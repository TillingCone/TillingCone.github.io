---
import Menu from './screens/Menu.astro';
import Stats from './screens/Stats.astro';
import Projects from './screens/Projects.astro';
import About from './screens/About.astro';
import Contact from './screens/Contact.astro';
import { profile } from '../data/profile';
---

<div class="gb">
  <button class="gb__palette" type="button" data-palette-toggle aria-label="Switch colour palette">
    <span data-palette-label>DMG</span>
  </button>

  <div class="gb__well">
    <span class="gb__leds" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="gb__power" aria-hidden="true"><span class="gb__led"></span>BATTERY</div>
    <div class="screen" data-screen-host>
      <Menu />
      <Stats />
      <Projects />
      <About />
      <Contact />
    </div>
    <p class="gb__well-label" aria-hidden="true">JERRY'S LITTLE WORLD</p>
  </div>

  <p class="gb__brand" aria-hidden="true">{profile.name}<span>BOY</span></p>

  <div class="gb__controls">
    <div class="dpad" role="group" aria-label="Directional pad">
      <button class="dpad__btn dpad__btn--up" type="button" data-btn="UP" aria-label="Up"></button>
      <button class="dpad__btn dpad__btn--left" type="button" data-btn="LEFT" aria-label="Left"></button>
      <span class="dpad__center" aria-hidden="true"></span>
      <button class="dpad__btn dpad__btn--right" type="button" data-btn="RIGHT" aria-label="Right"></button>
      <button class="dpad__btn dpad__btn--down" type="button" data-btn="DOWN" aria-label="Down"></button>
    </div>

    <div class="ab">
      <button class="ab__btn" type="button" data-btn="B" aria-label="B — back">B</button>
      <button class="ab__btn" type="button" data-btn="A" aria-label="A — select">A</button>
    </div>
  </div>

  <div class="gb__startsel">
    <button class="pill" type="button" data-btn="SELECT" aria-label="Select — back">SELECT</button>
    <button class="pill" type="button" data-btn="START" aria-label="Start — main menu">START</button>
  </div>

  <div class="gb__speaker" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i>
  </div>
</div>

<style>
  /* Touch behaviour for every control on the shell: no 300ms tap delay, no
     grey flash on Android, no text selection or page scroll when a finger
     drags across the D-pad, and no long-press callout. */
  .gb :where(button) {
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
  }

  .gb {
    position: relative;
    width: clamp(290px, 94vw, 400px);
    padding: 5% 5% 4%;
    background: var(--shell);
    border-radius: 12px 12px 22% 12px;
    box-shadow:
      inset 0 2px 0 var(--shell-light),
      inset 0 -4px 0 var(--shell-dark),
      0 18px 40px rgba(0, 0, 0, 0.55);
    transition: background-color 180ms linear;
  }

  /* Palette toggle sits on the shell like a real hardware switch. */
  .gb__palette {
    touch-action: manipulation;
    position: absolute;
    z-index: 3; /* above the screen well, which is taller on narrow screens */
    top: 8px;
    right: 10px;
    font: inherit;
    font-size: 8px;
    letter-spacing: 0.08em;
    padding: 5px 8px;
    color: var(--shell-dark);
    background: var(--shell-light);
    border: 1px solid var(--shell-dark);
    border-radius: 3px;
    cursor: pointer;
  }
  .gb__palette:active { transform: translateY(1px); }

  /* ── Screen well ─────────────────────────────────────────────────────── */

  .gb__well {
    position: relative;
    background: var(--well);
    border-radius: 8px 8px 40px 8px;
    padding: 26px 13% 20px;
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, 0.55);
  }

  .gb__leds {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 3px;
  }
  .gb__leds i { width: 26px; height: 2px; background: var(--well-dark); }

  .gb__power {
    position: absolute;
    left: 3%;
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-size: 6px;
    letter-spacing: 0.15em;
    color: #8a8a93;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .gb__led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d63b3b;
    box-shadow: 0 0 6px rgba(214, 59, 59, 0.9);
  }

  .gb__well-label {
    margin: 10px 0 0;
    text-align: center;
    font-size: 6px;
    letter-spacing: 0.1em;
    color: #8a8a93;
  }

  .gb__brand {
    margin: 10px 0 14px;
    font-size: 13px;
    color: var(--brand);
    letter-spacing: -0.02em;
  }
  .gb__brand span { font-size: 8px; margin-left: 3px; }

  /* ── Controls ────────────────────────────────────────────────────────── */

  .gb__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dpad {
    display: grid;
    --key: clamp(26px, 8.8vw, 32px);
    grid-template-columns: repeat(3, var(--key));
    grid-template-rows: repeat(3, var(--key));
    flex: 0 0 auto;
  }
  .dpad__btn,
  .dpad__center {
    background: var(--dpad);
    border: 0;
    padding: 0;
    cursor: pointer;
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.5);
  }
  .dpad__btn--up { grid-area: 1 / 2; border-radius: 5px 5px 0 0; }
  .dpad__btn--left { grid-area: 2 / 1; border-radius: 5px 0 0 5px; }
  .dpad__center { grid-area: 2 / 2; }
  .dpad__btn--right { grid-area: 2 / 3; border-radius: 0 5px 5px 0; }
  .dpad__btn--down { grid-area: 3 / 2; border-radius: 0 0 5px 5px; }
  .dpad__btn:active,
  .dpad__btn[data-pressed] { background: var(--dpad-active); box-shadow: none; }

  .ab {
    display: flex;
    align-items: center;
    gap: 12px;
    transform: rotate(-25deg);
  }
  .ab__btn {
    width: clamp(38px, 12vw, 46px);
    height: clamp(38px, 12vw, 46px);
    border-radius: 50%;
    border: 0;
    background: var(--btn);
    color: rgba(255, 255, 255, 0.8);
    font: inherit;
    font-size: 9px;
    cursor: pointer;
    box-shadow: inset 0 -3px 0 var(--btn-dark), 0 2px 3px rgba(0, 0, 0, 0.4);
  }
  .ab__btn:active,
  .ab__btn[data-pressed] { box-shadow: inset 0 2px 0 var(--btn-dark); transform: translateY(2px); }

  .gb__startsel {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin: 26px 0 0;
    transform: rotate(-25deg);
  }
  .pill {
    font: inherit;
    font-size: 6px;
    letter-spacing: 0.1em;
    color: var(--well-dark);
    background: #8c8a96;
    border: 0;
    border-radius: 20px;
    padding: 6px 12px;
    cursor: pointer;
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.35);
  }
  .pill:active,
  .pill[data-pressed] { box-shadow: inset 0 2px 0 rgba(0, 0, 0, 0.35); }

  .gb__speaker {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
    transform: rotate(-25deg);
    margin: 10px 6% 0;
  }
  .gb__speaker i {
    width: 5px;
    height: 34px;
    border-radius: 3px;
    background: var(--shell-dark);
    box-shadow: inset 0 1px 0 rgba(0, 0, 0, 0.3);
  }

</style>
